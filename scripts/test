#!/bin/sh
# Runs the tests. With only the Command Line Tools installed (no Xcode), the compiler does not
# find Swift Testing's macro plugin by itself, so this points it there.
set -eu
cd "$(dirname "$0")/.."
plugins=/Library/Developer/CommandLineTools/usr/lib/swift/host/plugins/testing
if [ "$(xcode-select -p 2>/dev/null)" = /Library/Developer/CommandLineTools ] && [ -d "$plugins" ]; then
	exec swift test -Xswiftc -plugin-path -Xswiftc "$plugins" "$@"
fi
exec swift test "$@"
