#!/bin/sh
# Creates a self-signed code-signing certificate in the login keychain, once. Signing every
# build with it keeps the app's identity stable, so macOS keeps its Input Monitoring grant.
set -eu
name="MicroBridge Local Signing"
if security find-identity -p codesigning | grep -q "$name"; then
	echo "certificate already present"
	exit 0
fi
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
cat > "$dir/req.cnf" <<EOF
[req]
distinguished_name = dn
x509_extensions = ext
prompt = no
[dn]
CN = $name
[ext]
keyUsage = critical, digitalSignature
extendedKeyUsage = critical, codeSigning
basicConstraints = critical, CA:false
EOF
/usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -config "$dir/req.cnf" \
	-keyout "$dir/key.pem" -out "$dir/cert.pem" 2>/dev/null
/usr/bin/openssl pkcs12 -export -inkey "$dir/key.pem" -in "$dir/cert.pem" \
	-name "$name" -out "$dir/id.p12" -passout pass:micro
security import "$dir/id.p12" -k "$HOME/Library/Keychains/login.keychain-db" -P micro -T /usr/bin/codesign
echo "created: $name"
